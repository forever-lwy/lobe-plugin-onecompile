{
  "identifier": "onecompiler-code-runner",
  "api": [
    {
      "url": "https://lobe-plugin-onecompile.vercel.app/api/generate",
      "name": "runCode",
      "description": "使用OneCompiler API执行多种编程语言的代码",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "要执行的源代码"
          },
          "language": {
            "type": "string",
            "description": "编程语言(python、javascript、java等)",
            "enum": ["python", "javascript", "java"],
            "default": "python"
          },
          "stdin": {
            "type": "string",
            "description": "程序的标准输入",
            "default": ""
          }
        },
        "required": ["code"]
      }
    }
  ],
  "meta": {
    "avatar": "💻",
    "description": "这个插件使用OneCompiler API运行多种编程语言的代码。",
    "tags": ["code", "compiler", "execution", "programming"],
    "title": "OneCompiler代码执行器"
  },
  "settings": {
    "type": "object",
    "required": ["RAPIDAPI_KEY", "PLUGIN_API_KEY"],
    "properties": {
      "RAPIDAPI_KEY": {
        "type": "string",
        "title": "RapidAPI Key",
        "description": "访问OneCompiler API的RapidAPI密钥",
        "format": "password"
      },
      "PLUGIN_API_KEY": {
        "type": "string",
        "title": "插件访问密钥",
        "description": "输入访问密钥以验证请求（必须与服务器配置匹配）",
        "default": "",
        "format": "password"
      },
      "CODE_LANGUAGE": {
        "type": "string",
        "title": "默认编程语言",
        "description": "设置默认的编程语言",
        "enum": ["python", "javascript", "java"],
        "default": "python"
      }
    }
  },
  "version": "1",
  "systemRole": "onecompiler-code-runner使用OneCompiler API执行多种编程语言的代码。您可以编写和执行代码来解决问题、演示概念或执行计算。当需要执行代码时，提供代码和语言类型，插件将返回执行结果。注意：代码的执行结果必须输出到标准输出中才能返回。"
}